\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 直接跨图像传播与 RouteSAM 语义路径传播的概念比较。直接传播试图一步将锚点 $A$ 的掩码迁移到目标 $T$；RouteSAM 则选择并排序桥接图像 $\{B_i\}$，让 SAM3 按照 $A\rightarrow B_1\rightarrow \cdots  \rightarrow B_b\rightarrow T$ 逐步传播。路径只在训练阶段使用，最终任务模型直接处理单幅测试图像。图中的掩码仅用于说明方法直觉。}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:motivation-zh}{{1}{2}{直接跨图像传播与 RouteSAM 语义路径传播的概念比较。直接传播试图一步将锚点 $A$ 的掩码迁移到目标 $T$；RouteSAM 则选择并排序桥接图像 $\{B_i\}$，让 SAM3 按照 $A\rightarrow B_1\rightarrow \cdots \rightarrow B_b\rightarrow T$ 逐步传播。路径只在训练阶段使用，最终任务模型直接处理单幅测试图像。图中的掩码仅用于说明方法直觉。}{figure.1}{}}
